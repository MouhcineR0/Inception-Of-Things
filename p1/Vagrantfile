Vagrant.configure("2") do |config|
	config.vm.define "rmouhcinS" do |mo|
		mo.vm.box = "ubuntu/focal64"
		mo.vm.hostname = "rmouhcinS"
		mo.vm.network "private_network", ip: "192.168.56.110"
	
		# entry script
		mo.vm.provision "shell", path: "scripts/server.sh"

		mo.vm.provider "virtualbox" do |vb|
			vb.memory = "1024"
			vb.cpus = 1
		end
	end
	config.vm.define "rmouhcinSW" do |mt|
		mt.vm.box = "ubuntu/focal64"
		mt.vm.hostname = "rmouhcinSW"
		mt.vm.network "private_network", ip: "192.168.56.111"
	
		# entry script
		mt.vm.provision "shell", path: "scripts/agent.sh"


		mt.vm.provider "virtualbox" do |vb|
			vb.memory = "1024"
			vb.cpus = 1
		end
	end


end
